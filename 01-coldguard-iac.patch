+# Tailscale Kubernetes Operator Helm values
+#
+# OAuth client 값은 Git과 Terraform State에 남지 않도록 values에 넣지 않습니다.
+# 설치 전에 tailscale 네임스페이스에 operator-oauth Secret(client_id, client_secret)을 직접 만듭니다.
+# 차트는 oauth 값이 없으면 이 Secret을 그대로 씁니다.
+
+operatorConfig:
+  hostname: coldguard-k8s-operator
+  defaultTags: "tag:k8s-operator"
+  resources:
+    requests:
+      cpu: 50m
+      memory: 64Mi
+    limits:
+      memory: 256Mi
+
+# Service·Ingress에 tailscale.com/tags 주석이 없을 때 프록시에 붙는 태그
+proxyConfig:
+  defaultTags: "tag:k8s"
