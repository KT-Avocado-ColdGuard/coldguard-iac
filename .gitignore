
# ==========================================
# ColdGuard Git Ignore
# ==========================================

# Terraform working directory
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files
*.tfvars
*.tfvars.json

# Allow example variable files
!*.tfvars.example
!*.tfvars.json.example

# Terraform plan files
*.tfplan
tfplan
tfplan.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI local configuration
.terraformrc
terraform.rc

# Lambda build artifacts
**/failover.zip

# Python cache
__pycache__/
*.pyc

# Environment variables and credentials
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/


ansible/group_vars/vault.yml
# 인증서·키·CSR
*.crt
*.key
*.csr
*.pem

# 인증서·키·CSR·패치
*.crt
*.key
*.csr
*.pem
*.patch

# ==========================================
# Ansible Vault
# ==========================================

# 모든 디렉터리의 vault.yml 제외
vault.yml

# Ansible 임시 파일
*.retry
*.log
*.bak
*.tmp

# Local app deployment inputs (copy the examples, do not commit filled values)
ansible/app-release.local.json
ansible/app-inventory.local.ini
ansible/.venv-apps/

# Ansible sensitive files
*_vault.yml
vault_*.yml
*.pw
ansible/inventory/hosts.ini
ansible/inventory/*.local.ini
