# ==========================================
# ColdGuard K3s Configuration
# ==========================================

node-ip: "{{ k3s_node_ip }}"

cluster-cidr: "{{ k3s_cluster_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"

{% if k3s_disable_traefik %}
disable:
  - traefik
{% endif %}

# ==========================================
# ECR Credential Provider
# ==========================================

image-credential-provider-bin-dir: "{{ ecr_provider_bin_dir }}"
image-credential-provider-config: "{{ ecr_provider_config }}"